digraph FootVerse {
 graph [rankdir=LR, splines=polyline, nodesep=0.28, ranksep=0.55, bgcolor="white", pad=0.2, fontname="Arial", fontsize=18, label="FootVerse — Database ER Diagram", labelloc=t];
 node [shape=box, style="rounded,filled", fillcolor="#f3f6fb", color="#476582", fontname="Arial", fontsize=9, margin="0.10,0.07"];
 edge [color="#526579", fontname="Arial", fontsize=8, arrowsize=0.7];
 team [label="TEAM\nPK team_id\nUK name, short_name"];
 player_position [label="PLAYER_POSITION\nPK position_name"];
 player [label="PLAYER\nPK player_id\nFK position_name, team_id\nUK (team_id, shirt_number)"];
 player_load [label="PLAYER_LOAD\nPK (player_id, day_no)\nFK player_id"];
 player_heatmap [label="PLAYER_HEATMAP\nPK (player_id, zone_x, zone_y)\nFK player_id"];
 trophy [label="TROPHY\nPK (team_id, trophy_no)\nFK team_id"];
 trophy_tag [label="TROPHY_TAG\nPK (team_id, trophy_no, tag)\nFK (team_id, trophy_no)"];
 legend [label="LEGEND\nPK (team_id, legend_no)\nFK team_id"];
 match_result [label="MATCH_RESULT\nPK match_id\nFK home_team_id, away_team_id, top_performer_id"];
 user_account [label="USER_ACCOUNT\nPK user_id\nUK command_id, email"];
 product [label="PRODUCT\nPK product_id\nFK team_id (optional)"];
 product_size [label="PRODUCT_SIZE\nPK (product_id, size)\nFK product_id"];
 discount [label="DISCOUNT\nPK code"];
 orders [label="ORDERS\nPK order_id\nFK user_id, discount_code (optional)\nSnapshot discount_percent"];
 order_item [label="ORDER_ITEM\nPK (order_id, line_no)\nFK order_id, product_id, (product_id,size)"];
 follows [label="FOLLOWS\nPK (team_id, user_id)\nFK team_id, user_id"];
 favorite_player [label="FAVORITE_PLAYER\nPK (user_id, player_id)\nFK user_id, player_id"];
 session [label="SESSION\nPK token_hash\nFK user_id"];
 player_position -> player [label="1 : N"];
 team -> player [label="1 : N"];
 player -> player_load [label="1 : N"];
 player -> player_heatmap [label="1 : N"];
 team -> trophy [label="1 : N"];
 trophy -> trophy_tag [label="1 : N"];
 team -> legend [label="1 : N"];
 team -> match_result [label="home / away", dir=both, arrowtail=none, arrowhead=normal];
 player -> match_result [label="top performer", style=dashed];
 team -> product [label="1 : N", style=dashed];
 product -> product_size [label="1 : N"];
 user_account -> orders [label="1 : N"];
 discount -> orders [label="0..1 : N", style=dashed];
 orders -> order_item [label="1 : N"];
 product -> order_item [label="1 : N"];
 product_size -> order_item [label="size FK"];
 user_account -> follows [label="1 : N"];
 team -> follows [label="1 : N"];
 user_account -> favorite_player [label="1 : N"];
 player -> favorite_player [label="1 : N"];
 user_account -> session [label="1 : N"];
}
